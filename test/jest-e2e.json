{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "globalSetup": "<rootDir>/jest-global-setup.js",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/\\.pnpm/(?!(cockatiel)@)"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^load-esm$": "<rootDir>/integration/load-esm-stub.ts"
  },
  "setupFiles": ["<rootDir>/e2e/support/env-setup.ts"],
  "maxWorkers": 1,
  "testTimeout": 90000
}
