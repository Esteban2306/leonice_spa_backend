{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "globalSetup": "<rootDir>/integration/global-setup.ts",
  "setupFiles": ["<rootDir>/integration/env-setup.ts"],
  "testTimeout": 60000,
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/\\.pnpm/(?!(cockatiel)@)"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}
