# Variables de la APLICACIÓN (las recibe solo el contenedor de la API).
# Copia a infra/app.env.production (NO lo subas a git) y rellena cada valor.
# DATABASE_URL, REDIS_URL, NODE_ENV y PORT los inyecta docker-compose.prod.yml.
# Genera secretos con:  openssl rand -hex 32   (JWT_SECRET y JWT_REFRESH_SECRET deben ser distintos)

CORS_ORIGIN=https://leonicespa.com,https://admin.leonicespa.com
FRONTEND_ADMIN_URL=https://admin.leonicespa.com
SPA_PUBLIC_URL=https://api.leonicespa.com
THROTTLE_LIMIT=100

JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
CANCELLATION_LINK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CONDUIT_BASE_URL=
CONDUIT_API_KEY=
CONDUIT_TOOL_API_KEY=
CONDUIT_WEBHOOK_SECRET=
CONDUIT_WHATSAPP_CONNECTION_ID=

# La estrategia de Google se registra siempre: la API no arranca sin estas tres
# variables. Si no usas el inicio de sesión con Google, deja valores de relleno.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.leonicespa.com/api/v1/auth/google/callback
