# Variables de INFRAESTRUCTURA (las lee docker compose; no llegan a la API).
# Copia a infra/.env.production (NO lo subas a git) y rellena cada valor.
# Genera secretos con:  openssl rand -hex 32
# Las contraseñas de base de datos y Redis deben ser hexadecimales (van dentro de URLs).

POSTGRES_DB=leonice_spa
POSTGRES_SUPERUSER=postgres_admin
POSTGRES_SUPERUSER_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
DB_BACKUP_PASSWORD=
DB_POOL_SIZE=10

REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

API_PORT=3000
APP_VERSION=local

# Administrador inicial: solo se usa con `--profile seed run --rm seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
CONDUIT_BASE_URL=
CONDUIT_API_KEY=

# Copias de seguridad. BACKUP_REMOTE vacío = solo copia local (no recomendado).
# Ejemplo de destino rclone: offsite:leonice-backups  (definido en el rclone.conf indicado)
BACKUP_REMOTE=
RCLONE_CONFIG_FILE=./backup/rclone.conf.empty
DUMP_INTERVAL_HOURS=6
BASE_INTERVAL_HOURS=24
VERIFY_INTERVAL_HOURS=168
WAL_SYNC_INTERVAL_MINUTES=5
BASE_BACKUPS_KEEP=7
